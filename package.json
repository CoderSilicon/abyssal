{
  "name": "abyssal",
  "displayName": "Abyssal",
  "description": "A deep-ocean dark color theme for Visual Studio Code. Near-black slate surfaces, muted desaturated syntax colors, and high-contrast accents for long sessions in low light.",
  "version": "0.3.0",
  "publisher": "codersilicon",
  "license": "Unlicense",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Themes"
  ],
  "icon": "assets/icon-128.png",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "keywords": [
    "theme",
    "dark",
    "dark theme",
    "minimal",
    "monochrome",
    "muted",
    "low contrast",
    "abyssal",
    "ocean",
    "solarized"
  ],
  "galleryBanner": {
    "color": "#0A0B0E",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codersilicon/abyssal.git"
  },
  "bugs": {
    "url": "https://github.com/codersilicon/abyssal/issues"
  },
  "homepage": "https://github.com/codersilicon/abyssal#readme",
  "scripts": {
    "vscode:prepublish": "npm run icon",
    "icon": "node tools/resize-icon.js 128",
    "package": "vsce package",
    "lint": "node -e \"JSON.parse(require('fs').readFileSync('package.json')); JSON.parse(require('fs').readFileSync('themes/Abyssal-color-theme.json')); console.log('json ok')\""
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  },
  "contributes": {
    "themes": [
      {
        "label": "Abyssal",
        "uiTheme": "vs-dark",
        "path": "./themes/Abyssal-color-theme.json"
      }
    ]
  }
}
